{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "skipLibCheck": true
  },
  "include": [
    "server.ts",
    "models/rosterMemberModel.ts",
    "models/rosterAdminModel.ts",
    "models/partnerModel.ts",
    "models/opportunityModel.ts",
    "models/deploymentModel.ts",
    "models/rosterEventModel.ts",
    "controllers/rosterMemberController.ts",
    "controllers/rosterAdminController.ts",
    "controllers/partnerController.ts",
    "protectRoutes/rosterMemberProtect.ts",
    "protectRoutes/rosterAdminProtect.ts",
    "protectRoutes/rosterPartnerProtect.ts",
    "routes/rosterMemberRoutes.ts",
    "routes/rosterAdminRoutes.ts",
    "routes/rosterPartnerRoutes.ts",
    "utils/firestore.ts",
    "utils/resend.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
