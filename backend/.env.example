# MongoDB connection string
DATABASE=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# JWT signing secret — use a long random string (e.g. openssl rand -hex 64)
JWTSK=

# Admin seeding — generate a strong secret: openssl rand -hex 32
ADMIN_SEED_KEY=

# Resend — roster email notifications (welcome, status updates, deployments, partner alerts)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email (legacy Gmail SMTP — used for general auth emails)
EMAIL_USER=noreply@worlddisastercenter.org
EMAIL_PASS=

# Cloudinary
CLOUD_NAME=
CLOUD_KEY=
CLOUD_KEY_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# CORS — set to your production frontend URL
ALLOWED_ORIGIN=https://worlddisastercenter.org

# Server
PORT=9000
NODE_ENV=development
